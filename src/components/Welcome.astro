---
---

<div id="container">
  <header>
    <nav>
      <span class="logo">Chris's Portfolio</span>
      <div class="nav-links">
        <a href="#about">About</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
      </div>
    </nav>
    <div class="bug" id="bug">🐛</div>
  </header>

  <main>
    <section id="hero">
      <div class="blob" id="blob"></div>
      <div class="tag">Full Stack Developer</div>
      <h1>Hi, I'm <span class="highlight" id="typed"></span><span class="cursor">|</span> 👩🏽‍💻</h1>
      <p class="subtitle">I build things at the intersecti on of software development and AI. I love debugging and translating ideas into meaningful products.</p>
      <div class="cta">
        <a href="#projects" class="btn-primary">See my work</a>
        <a href="#contact" class="btn-secondary">Get in touch</a>
      </div>
    </section>

    <section id="about">
      <h2>About me</h2>
      <p>I'm a current graduate student at Boston University where I am working towards getting my Master's degree in Computer Science! I'm an aspiring software engineer, interested in how AI is changing the way we build software. I enjoy working across the stack; from designing intuitive UIs to building backends and learning how to integrate intelligent systems.</p>
      <p>If you don't find me debugging something, I'm probably gaming or reading <3</p>
    </section>

    <section id="projects">
      <h2>Projects</h2>
      <div class="project-grid">
        <div class="project-card">
          <div class="project-tag">AI + Web</div>
          <h3>Smart Notes</h3>
          <p>An AI-powered note-taking app that summarizes, tags, and connects your ideas automatically.</p>
          <div class="project-links">
            <a href="#">GitHub</a>
            <a href="#">Live Demo</a>
          </div>
        </div>
        <div class="project-card">
          <div class="project-tag">Full Stack</div>
          <h3>DevDash</h3>
          <p>A developer productivity dashboard that aggregates GitHub activity, tasks, and calendar events in one place.</p>
          <div class="project-links">
            <a href="#">GitHub</a>
            <a href="#">Live Demo</a>
          </div>
        </div>
        <div class="project-card">
          <div class="project-tag">AI</div>
          <h3>CodeReview AI</h3>
          <p>A tool that uses LLMs to automatically review pull requests and suggest improvements.</p>
          <div class="project-links">
            <a href="#">GitHub</a>
            <a href="#">Live Demo</a>
          </div>
        </div>
      </div>
    </section>

    <section id="contact">
      <h2>Let's talk</h2>
      <p>I'm always open to new opportunities, collaborations, or just a good conversation about tech and AI.</p>
      <a href="mailto:chris@example.com" class="btn-primary">Say hello</a>
    </section>
  </main>

  <footer>
    <p>Built by Chris · 2025</p>
  </footer>
</div>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Lora:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap');

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  #container {
    font-family: 'DM Sans', sans-serif;
    background: linear-gradient(160deg, #c5eced 0%, #fdf8f3 40%);
    color: #2d2d2d;
    min-height: 100vh;
  }

    header {
    padding: 1.5rem 2rem;
    position: sticky;
    top: 0;
    background: #fdf8f3ee;
    backdrop-filter: blur(8px);
    z-index: 10;
    border-bottom: 1px solid #e8d9d5;
    overflow: hidden;
  }

  nav {
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-family: 'Lora', serif;
    font-size: 1.3rem;
    font-weight: 600;
    color: #2d2d2d;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .nav-links a {
    text-decoration: none;
    color: #6b6560;
    font-size: 0.95rem;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: #0f878f;
  }

  main {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  section {
    padding: 5rem 0;
    border-bottom: 1px solid #e8e0d5;
  }

  #hero {
    padding-top: 6rem;
    position: relative;
    overflow: hidden;
  }

  #hero > *:not(.blob) {
    position: relative;
    z-index: 1;
  }

  .blob {
    position: absolute;
    top: -80px;
    left: -100px;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, #c5eced 0%, #e8f7f7 50%, transparent 100%);
    border-radius: 60% 40% 70% 30% / 50% 60% 40% 50%;
    z-index: 0;
    filter: blur(50px);
    opacity: 0.8;
    transition: transform 0.15s ease-out;
    will-change: transform;
  }

  .tag {
    display: inline-block;
    background: #f5ebe0;
    color: #0f878f;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.4rem 0.9rem;
    border-radius: 100px;
    margin-bottom: 1.2rem;
  }

  h1 {
    font-family: 'Lora', serif;
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 1.2rem;
  }

  .highlight {
    color: #0f878f;
  }

  .cursor {
    display: inline-block;
    color: #0f878f;
    font-weight: 300;
    animation: blink 0.8s step-end infinite;
    margin-left: 1px;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .subtitle {
    font-size: 1.15rem;
    color: #384244;
    line-height: 1.7;
    max-width: 560px;
    margin-bottom: 2rem;
  }

  .cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    background: #0f878f;
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 500;
    transition: background 0.2s;
  }

  .btn-primary:hover {
    background: #0a6b72;
  }

  .btn-secondary {
    background: transparent;
    color: #2d2d2d;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    border: 1px solid #c8bfb5;
    text-decoration: none;
    font-weight: 500;
    transition: border-color 0.2s;
  }

  .btn-secondary:hover {
    border-color: #0f878f;
    color: #0f878f;
  }

  h2 {
    font-family: 'Lora', serif;
    font-size: 1.8rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  #about p {
    color: #6b6560;
    line-height: 1.8;
    margin-bottom: 1rem;
    max-width: 620px;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .project-card {
    background: #fff;
    border: 1px solid #e8e0d5;
    border-radius: 12px;
    padding: 1.5rem;
    transition: box-shadow 0.2s;
  }

  .project-card:hover {
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  }

  .project-tag {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #0f878f;
    margin-bottom: 0.6rem;
  }

  .project-card h3 {
    font-family: 'Lora', serif;
    font-size: 1.1rem;
    margin-bottom: 0.6rem;
  }

  .project-card p {
    font-size: 0.9rem;
    color: #6b6560;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .project-links {
    display: flex;
    gap: 1rem;
  }

  .project-links a {
    font-size: 0.85rem;
    color: #0f878f;
    text-decoration: none;
    font-weight: 500;
  }

  .project-links a:hover {
    text-decoration: underline;
  }

  #contact {
    border-bottom: none;
  }

  #contact p {
    color: #6b6560;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    max-width: 500px;
  }

  footer {
    text-align: center;
    padding: 2rem;
    font-size: 0.85rem;
    color: #a89f96;
  }

  @media (max-width: 600px) {
    .nav-links { gap: 1rem; }
    section { padding: 3rem 0; }
  }
</style>

<script>
  // Typing effect
  const typed = document.getElementById('typed');
  const text = 'Chris';
  let i = 0;

  function type() {
    if (i < text.length) {
      typed.textContent += text[i];
      i++;
      setTimeout(type, 120);
    }
  }

  setTimeout(type, 500);

  // Wobbly blob on scroll
  const blob = document.getElementById('blob');
  let lastScroll = window.scrollY;
  let velocity = 0;
  let blobY = 0;

  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;
    velocity = currentScroll - lastScroll;
    lastScroll = currentScroll;
    blobY -= velocity * 0.4;
  });

  function animateBlob() {
    blobY *= 0.88;
    blob.style.transform = `translateY(${blobY}px)`;
    requestAnimationFrame(animateBlob);
  }

  animateBlob();

   const bug = document.getElementById('bug');
  
  function crawlBug() {
    bug.style.transition = 'none';
    bug.style.left = '-30px';
    bug.style.opacity = '1';
    
    setTimeout(() => {
      bug.style.transition = 'left 4s linear';
      bug.style.left = '110%';
      
      setTimeout(() => {
        bug.style.opacity = '0';
        setTimeout(crawlBug, Math.random() * 8000 + 5000);
      }, 4000);
    }, 100);
  }

  setTimeout(crawlBug, 2000);
</script>