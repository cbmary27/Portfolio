type Rect = { x: number; y: number; w: number; h: number; fill: string };

// Turns rows of characters into horizontal runs of pixel rects.
// Any character missing from the palette (like '.') is transparent.
function sprite(rows: string[], ox: number, oy: number, palette: Record<string, string>): Rect[] {
  const rects: Rect[] = [];
  rows.forEach((row, y) => {
    let x = 0;
    while (x < row.length) {
      const fill = palette[row[x]];
      if (!fill) { x++; continue; }
      let w = 1;
      while (row[x + w] === row[x]) w++;
      rects.push({ x: ox + x, y: oy + y, w, h: 1, fill });
      x += w;
    }
  });
  return rects;
}

const r = (x: number, y: number, w: number, h: number, fill: string): Rect => ({ x, y, w, h, fill });

const SKIN = '#f2c6a0';
const HOODIE = '#6c5ce7';
const SLEEVE = '#574ad0';
const PANTS = '#2b3466';

// Room
const room = [
  r(0, 0, 128, 84, '#151a36'),
  r(0, 70, 128, 14, '#12172f'),
  r(0, 70, 128, 1, '#1d2347'),
  r(0, 83, 128, 1, '#232a55'),
  r(0, 84, 128, 12, '#0e1129'),
  r(0, 90, 128, 1, '#0b0e22'),
  r(30, 87, 70, 5, '#1c1f4a'),
  r(30, 88, 70, 1, '#262a5c'),
  r(30, 90, 70, 1, '#262a5c'),
];

// String lights along the top of the wall
const wire: Rect[] = [];
const bulbs: { x: number; y: number; fill: string; delay: number }[] = [];
const bulbColors = ['#ff8fd1', '#ffd36e', '#7cf2ff', '#b6a6ff'];
for (let x = 0; x < 128; x++) {
  const y = 2 + Math.round(2 * Math.abs(Math.sin((Math.PI * x) / 32)));
  wire.push(r(x, y, 1, 1, '#2a2f55'));
  if (x % 8 === 4) {
    const i = (x >> 3) % 4;
    bulbs.push({ x, y: y + 1, fill: bulbColors[i], delay: i * 0.45 });
  }
}

// Framed heart poster + shelf with a plant and books
const poster = [
  r(22, 12, 15, 13, '#3d4685'),
  r(23, 13, 13, 11, '#1f1840'),
  ...sprite([
    '.hh.hh.',
    'hwhhhhh',
    'hhhhhhh',
    '.hhhhh.',
    '..hhh..',
    '...h...',
  ], 26, 15, { h: '#ff8fd1', w: '#ffd6f0' }),
];

const shelf = [
  r(2, 31, 14, 1, '#5b3f5e'),
  r(4, 32, 1, 2, '#5b3f5e'),
  r(13, 32, 1, 2, '#5b3f5e'),
  ...sprite([
    '....l....',
    '..l.l.l..',
    '...lll...',
    '.l.lll.l.',
    '..lllll..',
    '...lLl...',
    '....l....',
  ], 4, 20, { l: '#4fd1a5', L: '#2f9e7a' }),
  r(5, 27, 7, 1, '#d98a66'),
  r(6, 28, 5, 3, '#c0704f'),
  r(12, 26, 2, 5, '#7cf2ff'),
  r(14, 27, 1, 4, '#ffd36e'),
];

// Window: sky, moon, stars, skyline
const sky = [
  r(74, 10, 46, 42, '#2c3263'),
  r(74, 10, 46, 1, '#3d4685'),
  r(74, 10, 1, 42, '#3d4685'),
  r(76, 12, 42, 10, '#0a0d29'),
  r(76, 22, 42, 10, '#0e1336'),
  r(76, 32, 42, 8, '#131a44'),
  r(76, 40, 42, 10, '#1a2253'),
];

const moon = sprite([
  '..mmmm.',
  '.mmmd..',
  'mmmd...',
  'mmmd...',
  'mmmd...',
  '.mmmd..',
  '..mmmm.',
], 82, 14, { m: '#fff4c2', d: '#e6d79a' });

const stars = [
  [78, 25, 0], [92, 23, 1], [100, 14, 2], [106, 24, 0], [113, 14, 1],
  [116, 28, 2], [101, 30, 1], [88, 27, 2], [79, 14, 1], [93, 16, 0],
];

const skylineFar = [
  r(76, 38, 6, 12, '#121842'),
  r(84, 35, 5, 15, '#121842'),
  r(92, 40, 8, 10, '#121842'),
  r(104, 36, 6, 14, '#121842'),
  r(112, 39, 6, 11, '#121842'),
];
const skylineNear = [
  r(76, 42, 5, 8, '#070918'),
  r(81, 40, 4, 10, '#070918'),
  r(87, 43, 7, 7, '#070918'),
  r(99, 38, 5, 12, '#070918'),
  r(104, 44, 6, 6, '#070918'),
  r(111, 41, 5, 9, '#070918'),
  r(116, 43, 2, 7, '#070918'),
  r(101, 35, 1, 3, '#070918'),
];
const cityWindows = [
  [77, 44, 0], [79, 46, 1], [82, 42, 0], [83, 45, 2], [100, 40, 1], [102, 43, 0],
  [100, 46, 2], [112, 43, 1], [114, 46, 0], [88, 45, 1], [91, 47, 0], [106, 46, 2],
];

const windowFrame = [
  r(96, 12, 2, 38, '#2c3263'),
  r(76, 30, 42, 2, '#2c3263'),
  r(66, 7, 62, 1, '#8a7a9e'),
  r(65, 6, 2, 3, '#b6a6c9'),
  // curtains
  r(66, 8, 8, 48, '#43357a'),
  r(68, 8, 1, 48, '#352a63'),
  r(71, 8, 1, 48, '#352a63'),
  r(119, 8, 9, 48, '#43357a'),
  r(121, 8, 1, 48, '#352a63'),
  r(124, 8, 1, 48, '#352a63'),
];

const cat = sprite([
  'c.....c.',
  'cp...pc.',
  'ccccccc.',
  'cdcccdc.',
  '.ccccc..',
  '.cdcdcc.',
  'ccccccc.',
  'cdcdcccc',
  'cccccccc',
  'cccccccc',
], 100, 42, { c: '#5b6094', d: '#474b7d', p: '#ff9fb8' });
const catTail = [r(108, 50, 2, 1, '#5b6094'), r(109, 48, 1, 2, '#5b6094'), r(110, 47, 1, 1, '#5b6094')];

const sill = [
  r(71, 52, 52, 3, '#3d4685'),
  r(71, 52, 52, 1, '#4d58a0'),
  r(72, 55, 50, 1, '#0e1230'),
];

// Chair
const chair = [
  r(72, 44, 5, 19, '#3a3170'),
  r(72, 44, 1, 19, '#4b4290'),
  r(58, 63, 19, 3, '#3a3170'),
  r(66, 66, 2, 12, '#22264a'),
  r(60, 78, 14, 2, '#22264a'),
  r(60, 80, 2, 2, '#15183a'),
  r(72, 80, 2, 2, '#15183a'),
];

// Legs go under the desk, so they're drawn before it
const legs = [
  r(44, 62, 27, 4, PANTS),
  r(44, 66, 5, 16, PANTS),
  r(48, 66, 1, 16, '#222a55'),
  r(41, 82, 9, 2, '#e9e6ff'),
  r(41, 83, 9, 1, '#b9b4e0'),
];

const desk = [
  r(4, 62, 54, 3, '#6b4a5a'),
  r(4, 62, 54, 1, '#85607a'),
  r(4, 65, 54, 1, '#3d2a3d'),
  r(6, 66, 3, 18, '#3d2a3d'),
  r(51, 66, 3, 18, '#3d2a3d'),
];

// Monitor + code
const monitor = [
  r(16, 34, 32, 24, '#252b52'),
  r(16, 34, 32, 1, '#343c70'),
  r(18, 36, 28, 20, '#070b1a'),
  r(18, 36, 28, 1, '#1a2147'),
  r(19, 36, 1, 1, '#ff8fd1'),
  r(21, 36, 1, 1, '#ffd36e'),
  r(23, 36, 1, 1, '#7cf2ff'),
  r(30, 58, 4, 3, '#252b52'),
  r(26, 61, 12, 1, '#252b52'),
];

const syntax: Record<string, string> = { k: '#ff8fd1', f: '#7cf2ff', s: '#ffd36e', p: '#b9bfe8', c: '#5a628f' };
const codeLines: [number, string][][] = [
  [[0, ''], [3, 'k'], [7, 'f'], [2, 'p']],
  [[2, ''], [4, 'k'], [3, 'p'], [8, 's']],
  [[2, ''], [5, 'f'], [2, 'p'], [6, 'c']],
  [[4, ''], [2, 'k'], [4, 'p'], [6, 'f']],
  [[4, ''], [3, 'p'], [9, 's']],
  [[2, ''], [5, 'k'], [6, 'p']],
  [[0, ''], [10, 'c']],
  [[0, ''], [3, 'k'], [5, 'f'], [3, 'p']],
  [[2, ''], [4, 'p'], [6, 's'], [2, 'p']],
];
const code: Rect[] = [];
for (const copy of [0, 18]) {
  codeLines.forEach((segments, i) => {
    let x = 20;
    for (const [len, kind] of segments) {
      if (kind) code.push(r(x, 38 + i * 2 + copy, len, 1, syntax[kind]));
      x += len + (kind ? 1 : 0);
    }
  });
}

const keyboard = [r(42, 60, 14, 2, '#2f3766')];
for (let x = 43; x < 55; x += 2) keyboard.push(r(x, 60, 1, 1, '#4a5490'));

const mug = sprite([
  'ccccc..',
  'mmmmmhh',
  'mmwmm.h',
  'mmmmmhh',
  'mmmmm..',
  '.mmm...',
], 6, 56, { c: '#4a2e2a', m: '#ff8fd1', h: '#ff8fd1', w: '#ffffff' });

// The girl: facing left toward her monitor, long hair, glasses
const head = sprite([
  '....HHHHHHH...',
  '..HHHHHHHHkk..',
  '.HHHhhhHHHkkHH',
  '.HHhHHHHHHHHHH',
  '.SSSSHHHHHHHHH',
  '.SSSSSHHHHHHHH',
  'GGGGGSSHHHHHHH',
  'G...GGGGHHHHHH',
  'SGGGGSSHHHHHHH',
  '.SSSSbSHHHHHHH',
  '.SpSSsHHHHHHHH',
  '..SSsHHHHHHHHH',
  '...ssHHHHHHHHH',
  '...ssHHHHHHHH.',
], 58, 30, { H: '#4a2b52', h: '#7a4a80', k: '#ff8fd1', S: SKIN, s: '#d99c7a', b: '#ff9fb8', p: '#c76b7b', G: '#0b0b14' });

const torso = sprite([
  '.......ss.HHHHHHH',
  '......TTTTTHHHHHHH',
  '.....TTTTTTTHHHHHH',
  '....TTTTTTTTTHHHHH',
  '....TTTTTTTTTTHHHH',
  '...TTTTTTTTTTTTHHH',
  '...TTTTTTTTTTTTTH.',
  '...TTTTTTTTTTTTTT.',
  '...TTTTTTTTTTTTTT.',
  '...TTTTTTTTTTTTTT.',
  '...TTTTTTTTTTTTTT.',
  '...TTTTTTTTTTTTTT.',
  '...TTTTTTTTTTTTTT.',
  '...TTTTTTTTTTTTTT.',
  '...TTTTTTTTTTTTTT.',
  '...TTTTTTTTTTTTTT.',
  '...TTTTTTTTTTTTTT.',
  '...bbbbbbbbbbbbbb.',
  '...bbbbbbbbbbbbbb.',
], 54, 43, { T: HOODIE, b: '#4b3fb5', s: '#d99c7a', H: '#4a2b52' });

const arm = [
  r(58, 48, 1, 3, '#e9e6ff'),
  r(59, 46, 4, 10, SLEEVE),
  r(53, 55, 9, 3, SLEEVE),
  r(51, 56, 2, 3, '#9d8cff'),
];
const hand = [r(48, 58, 3, 2, SKIN), r(47, 59, 1, 1, SKIN)];
---

<svg
  class="pixel-scene"
  viewBox="0 0 128 96"
  shape-rendering="crispEdges"
  role="img"
  aria-label="Pixel art of a girl with glasses coding at her desk late at night, next to a window with the moon, city lights and a cat on the sill"
>
  <defs>
    <radialGradient id="screen-glow">
      <stop offset="0%" stop-color="#7cf2ff" stop-opacity="0.28" />
      <stop offset="100%" stop-color="#7cf2ff" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="moon-glow">
      <stop offset="0%" stop-color="#fff4c2" stop-opacity="0.22" />
      <stop offset="100%" stop-color="#fff4c2" stop-opacity="0" />
    </radialGradient>
    <clipPath id="screen-clip"><rect x="18" y="37" width="28" height="19" /></clipPath>
    <clipPath id="glass-clip"><rect x="76" y="12" width="42" height="38" /></clipPath>
  </defs>

  {room.map((p) => <rect x={p.x} y={p.y} width={p.w} height={p.h} fill={p.fill} />)}
  <polygon points="78,84 118,84 128,96 90,96" fill="#9fb4ff" opacity="0.05" />

  {wire.map((p) => <rect x={p.x} y={p.y} width={p.w} height={p.h} fill={p.fill} />)}
  {bulbs.map((b) => (
    <g class="bulb" style={`animation-delay: ${b.delay}s`}>
      <circle cx={b.x + 1} cy={b.y + 1} r="2" fill={b.fill} fill-opacity="0.3" />
      <rect x={b.x} y={b.y} width="2" height="2" fill={b.fill} />
    </g>
  ))}

  {poster.map((p) => <rect x={p.x} y={p.y} width={p.w} height={p.h} fill={p.fill} />)}
  {shelf.map((p) => <rect x={p.x} y={p.y} width={p.w} height={p.h} fill={p.fill} />)}

  {sky.map((p) => <rect x={p.x} y={p.y} width={p.w} height={p.h} fill={p.fill} />)}
  <g clip-path="url(#glass-clip)">
    <circle cx="85.5" cy="17.5" r="10" fill="url(#moon-glow)" />
    {moon.map((p) => <rect x={p.x} y={p.y} width={p.w} height={p.h} fill={p.fill} />)}
    {stars.map(([x, y, d]) => <rect class={`star d${d}`} x={x} y={y} width="1" height="1" fill="#ffffff" />)}
    <g class="star d1">
      <rect x="110" y="19" width="1" height="1" fill="#ffffff" />
      <rect x="109" y="19" width="3" height="1" fill="#cfd6ff" opacity="0.6" />
      <rect x="110" y="18" width="1" height="3" fill="#cfd6ff" opacity="0.6" />
    </g>
    {skylineFar.map((p) => <rect x={p.x} y={p.y} width={p.w} height={p.h} fill={p.fill} />)}
    {skylineNear.map((p) => <rect x={p.x} y={p.y} width={p.w} height={p.h} fill={p.fill} />)}
    {cityWindows.map(([x, y, d]) => <rect class={`city-light d${d}`} x={x} y={y} width="1" height="1" fill="#ffd36e" />)}
    <rect class="antenna" x="101" y="34" width="1" height="1" fill="#ff5577" />
  </g>
  {windowFrame.map((p) => <rect x={p.x} y={p.y} width={p.w} height={p.h} fill={p.fill} />)}

  {cat.map((p) => <rect x={p.x} y={p.y} width={p.w} height={p.h} fill={p.fill} />)}
  <g class="tail">{catTail.map((p) => <rect x={p.x} y={p.y} width={p.w} height={p.h} fill={p.fill} />)}</g>
  {sill.map((p) => <rect x={p.x} y={p.y} width={p.w} height={p.h} fill={p.fill} />)}

  {chair.map((p) => <rect x={p.x} y={p.y} width={p.w} height={p.h} fill={p.fill} />)}
  {legs.map((p) => <rect x={p.x} y={p.y} width={p.w} height={p.h} fill={p.fill} />)}

  <ellipse cx="32" cy="46" rx="30" ry="22" fill="url(#screen-glow)" class="glow" />
  {desk.map((p) => <rect x={p.x} y={p.y} width={p.w} height={p.h} fill={p.fill} />)}
  {monitor.map((p) => <rect x={p.x} y={p.y} width={p.w} height={p.h} fill={p.fill} />)}
  <g clip-path="url(#screen-clip)">
    <g class="code">{code.map((p) => <rect x={p.x} y={p.y} width={p.w} height={p.h} fill={p.fill} />)}</g>
  </g>
  <rect x="18" y="36" width="28" height="20" fill="#7cf2ff" fill-opacity="0.05" class="glow" />
  {keyboard.map((p) => <rect x={p.x} y={p.y} width={p.w} height={p.h} fill={p.fill} />)}

  {mug.map((p) => <rect x={p.x} y={p.y} width={p.w} height={p.h} fill={p.fill} />)}
  <rect class="steam s0" x="7" y="52" width="1" height="2" fill="#cfd6ff" />
  <rect class="steam s1" x="9" y="51" width="1" height="2" fill="#cfd6ff" />
  <rect class="steam s2" x="8" y="49" width="1" height="2" fill="#cfd6ff" />

  {torso.map((p) => <rect x={p.x} y={p.y} width={p.w} height={p.h} fill={p.fill} />)}
  <g class="head">
    {head.map((p) => <rect x={p.x} y={p.y} width={p.w} height={p.h} fill={p.fill} />)}
    <rect class="lens" x="59" y="37" width="3" height="1" fill="#8ff3ff" />
  </g>
  {arm.map((p) => <rect x={p.x} y={p.y} width={p.w} height={p.h} fill={p.fill} />)}
  <g class="hand">{hand.map((p) => <rect x={p.x} y={p.y} width={p.w} height={p.h} fill={p.fill} />)}</g>

  <polygon points="46,37 70,29 72,64 46,56" fill="#7cf2ff" fill-opacity="0.07" class="glow" />
</svg>

<style>
  .pixel-scene {
    display: block;
    width: 100%;
    height: auto;
    image-rendering: pixelated;
  }

  .bulb { animation: bulb 1.8s steps(1, end) infinite; }
  .star { animation: twinkle 2.4s steps(1, end) infinite; }
  .city-light { animation: city 5s steps(1, end) infinite; }
  .d1 { animation-delay: 0.8s; }
  .d2 { animation-delay: 1.6s; }
  .antenna { animation: twinkle 1.2s steps(1, end) infinite; }
  .tail { animation: tail 1.6s steps(1, end) infinite; }
  .code { animation: scroll 9s steps(9, end) infinite; }
  .glow { animation: flicker 4s steps(1, end) infinite; }
  .lens { animation: lens 3s steps(1, end) infinite; }
  .head { animation: bob 2.4s steps(1, end) infinite; }
  .hand { animation: tap 0.35s steps(1, end) infinite; }
  .steam { animation: steam 2.4s steps(4, end) infinite; opacity: 0; }
  .s1 { animation-delay: 0.8s; }
  .s2 { animation-delay: 1.6s; }

  @keyframes bulb { 0%, 100% { opacity: 1; } 50% { opacity: 0.45; } }
  @keyframes twinkle { 0%, 100% { opacity: 1; } 40% { opacity: 0.3; } 70% { opacity: 0.7; } }
  @keyframes city { 0%, 100% { opacity: 1; } 60% { opacity: 0.15; } 80% { opacity: 1; } }
  @keyframes tail { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(1px); } }
  @keyframes scroll { from { transform: translateY(0); } to { transform: translateY(-18px); } }
  @keyframes flicker { 0%, 100% { opacity: 1; } 47% { opacity: 0.75; } 50% { opacity: 1; } }
  @keyframes lens { 0%, 100% { opacity: 1; } 50% { opacity: 0.7; } }
  @keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(1px); } }
  @keyframes tap { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-1px); } }
  @keyframes steam {
    0% { transform: translateY(0); opacity: 0.7; }
    100% { transform: translateY(-6px); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pixel-scene * { animation: none !important; }
    .steam { opacity: 0.4; }
  }
</style>
