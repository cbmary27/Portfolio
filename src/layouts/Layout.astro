---
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#0b0e1f" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Chris's Portfolio</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400..700&family=Silkscreen&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
	</head>
	<body>
		<canvas id="starfield" aria-hidden="true"></canvas>
		<slot />
	</body>
</html>

<script>
	// Pixel starfield: drawn at low resolution and scaled up so every star is a chunky pixel.
	const canvas = document.getElementById('starfield');
	const ctx = canvas instanceof HTMLCanvasElement ? canvas.getContext('2d') : null;

	if (canvas instanceof HTMLCanvasElement && ctx) {
		const PX = 3;
		const colors = ['#ffffff', '#cfd6ff', '#7cf2ff', '#ffd6f0', '#ffe9a8'];
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		type Star = { x: number; y: number; color: string; phase: number; speed: number; big: boolean };
		type Shooter = { x: number; y: number; life: number };

		let stars: Star[] = [];
		let shooter: Shooter | null = null;
		let nextShooter = 4000;

		const resize = () => {
			canvas.width = Math.ceil(window.innerWidth / PX);
			canvas.height = Math.ceil(window.innerHeight / PX);
			const count = Math.round((canvas.width * canvas.height) / 450);
			stars = Array.from({ length: count }, () => ({
				x: Math.floor(Math.random() * canvas.width),
				y: Math.floor(Math.random() * canvas.height),
				color: colors[Math.floor(Math.random() * colors.length)],
				phase: Math.random() * Math.PI * 2,
				speed: 0.4 + Math.random() * 1.4,
				big: Math.random() < 0.06,
			}));
		};

		const draw = (t: number) => {
			ctx.clearRect(0, 0, canvas.width, canvas.height);
			for (const s of stars) {
				const wave = reduceMotion ? 0.6 : 0.5 + 0.5 * Math.sin((t / 1000) * s.speed + s.phase);
				// Quantise brightness so the twinkle steps like an old screen.
				ctx.globalAlpha = 0.2 + Math.round(wave * 4) * 0.2 * (s.big ? 1 : 0.7);
				ctx.fillStyle = s.color;
				ctx.fillRect(s.x, s.y, 1, 1);
				if (s.big) {
					ctx.globalAlpha *= 0.4;
					ctx.fillRect(s.x - 1, s.y, 3, 1);
					ctx.fillRect(s.x, s.y - 1, 1, 3);
				}
			}
			if (shooter) {
				for (let i = 0; i < 8; i++) {
					ctx.globalAlpha = (1 - i / 8) * Math.min(1, shooter.life / 20);
					ctx.fillStyle = '#ffffff';
					ctx.fillRect(Math.round(shooter.x - i * 2), Math.round(shooter.y - i), 2, 1);
				}
			}
			ctx.globalAlpha = 1;
		};

		let last = 0;
		const loop = (t: number) => {
			if (t - last > 66) {
				const dt = t - last;
				last = t;
				nextShooter -= dt;
				if (!shooter && nextShooter <= 0) {
					shooter = { x: Math.random() * canvas.width * 0.6, y: Math.random() * canvas.height * 0.4, life: 40 };
					nextShooter = 7000 + Math.random() * 8000;
				}
				if (shooter) {
					shooter.x += 6;
					shooter.y += 3;
					shooter.life -= 1;
					if (shooter.life <= 0) shooter = null;
				}
				draw(t);
			}
			requestAnimationFrame(loop);
		};

		resize();
		window.addEventListener('resize', () => {
			resize();
			if (reduceMotion) draw(0);
		});

		if (reduceMotion) draw(0);
		else requestAnimationFrame(loop);
	}
</script>
